# Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Use your Atlas username/password and cluster name below.
# Example using the credentials supplied by the user:
#   MONGO_URI=mongodb+srv://NagarjunChats:qtvO3YmsNry5r0LN@<cluster>.mongodb.net/chat_db?retryWrites=true&w=majority
# Replace <cluster> with your actual cluster host
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chat_db?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# CORS Configuration
# List origins as comma-separated values (will be split into array)
# Include your frontend URL and any other origins that need access
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
